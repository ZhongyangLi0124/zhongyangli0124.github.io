+{% extends "base.html" %}
+{% block title %}{% if query %}Search: {{ query }}{% else %}Search{% endif %} &middot; {{ site_title }}{% endblock %}
+{% block content %}
+<h1 class="page-title">Search</h1>
+
+<form class="search-form-wide" method="get" action="{{ url_for('search') }}" role="search">
+  <input type="search" name="q" value="{{ query }}" placeholder="Search simulation titles or topics" autofocus>
+  <button type="submit" class="btn btn-primary">Search</button>
+</form>
+
+{% if query %}
+  <p class="page-subtitle">{{ total }} result{{ '' if total == 1 else 's' }} for &ldquo;{{ query }}&rdquo;</p>
+  {% if sims %}
+    <div class="sim-grid">
+      {% for sim in sims %}
+        {% include "_sim_card.html" %}
+      {% endfor %}
+    </div>
+  {% else %}
+    <p class="empty-state">No simulations matched your search. Try a shorter or more general term.</p>
+  {% endif %}
+{% else %}
+  <p class="page-subtitle">Enter a search term to find simulations by title or topic.</p>
+{% endif %}
+{% endblock %}
diff --git a/sites/phet_simulations/templates/simulation_detail.html b/sites/phet_simulations/templates/simulation_detail.html
new file mode 100644
index 0000000..35f4284
--- /dev/null
+++ b/sites/phet_simulations/templates/simulation_detail.html
@@ -0,0 +1,122 @@
+{% extends "base.html" %}
+{% block title %}{{ sim.title }} &middot; {{ site_title }}{% endblock %}
+{% block content %}
+<nav class="breadcrumb" aria-label="Breadcrumb">
+  <a href="{{ url_for('index') }}">Home</a> /
+  <a href="{{ url_for('simulations') }}">Simulations</a> /
+  <span>{{ sim.title }}</span>
+</nav>
+
+<article class="sim-detail">
+  <header class="sim-detail-head">
+    <h1>{{ sim.title }}</h1>
+    <p class="sim-detail-tagline">{{ sim.short_description }}</p>
+    <ul class="badge-row">
+      {% if sim.is_html5 %}<li class="badge badge-html5">HTML5</li>{% endif %}
+      {% if sim.is_new %}<li class="badge badge-new">New</li>{% endif %}
+      {% if sim.is_featured %}<li class="badge badge-featured">Featured</li>{% endif %}
+      <li class="badge badge-version">v{{ sim.version }}</li>
+    </ul>
+  </header>
+
+  <div class="sim-detail-body">
+    <div class="sim-detail-main">
+      <div class="sim-detail-frame">
+        <span class="sim-detail-frame-label">{{ sim.title }}</span>
+        <button class="btn btn-primary sim-detail-play" type="button">Play simulation</button>
+      </div>
+
+      <section class="sim-detail-section">
+        <h2>About this simulation</h2>
+        <p>{{ sim.overview }}</p>
+      </section>
+
+      <section class="sim-detail-section">
+        <h2>Learning goals</h2>
+        <ul class="topic-list">
+          {% for topic in sim.topics() %}
+            <li>{{ topic|capitalize }}</li>
+          {% endfor %}
+        </ul>
+      </section>
+
+      {% if activities %}
+      <section class="sim-detail-section">
+        <h2>Teacher-submitted activities ({{ activities|length }})</h2>
+        <ul class="activity-list">
+          {% for activity in activities %}
+            <li>
+              <a href="{{ url_for('activity_detail', activity_id=activity.id) }}">{{ activity.title }}</a>
+              <span class="activity-meta">by {{ activity.author }} &middot; {{ activity.grade_level|capitalize }} &middot; {{ activity.duration_min }} min</span>
+            </li>
+          {% endfor %}
+        </ul>
+      </section>
+      {% endif %}
+
+      {% if related %}
+      <section class="sim-detail-section">
+        <h2>Related simulations</h2>
+        <div class="sim-grid sim-grid-small">
+          {% for sim in related %}
+            {% include "_sim_card.html" %}
+          {% endfor %}
+        </div>
+      </section>
+      {% endif %}
+    </div>
+
+    <aside class="sim-detail-side">
+      <div class="side-card">
+        <h3>Subjects</h3>
+        <ul>
+          {% for s in subjects %}
+            <li><a href="{{ url_for('simulations_by_subject', slug=s.slug) }}">{{ s.name }}</a></li>
+          {% endfor %}
+        </ul>
+      </div>
+      <div class="side-card">
+        <h3>Grade levels</h3>
+        <ul>
+          {% for g in grades %}
+            <li>{{ g.name }} <small>({{ g.age_range }})</small></li>
+          {% endfor %}
+        </ul>
+      </div>
+      <div class="side-card">
+        <h3>Available in</h3>
+        <ul class="lang-list">
+          {% for l in languages %}
+            <li><a href="{{ url_for('translation_detail', code=l.code) }}">{{ l.name }}</a></li>
+          {% endfor %}
+        </ul>
+      </div>
+      <div class="side-card">
+        <h3>Statistics</h3>
+        <ul>
+          <li>Plays: {{ sim.play_count }}</li>
+          <li>Downloads: {{ sim.download_count }}</li>
+          <li>Runtime: {{ sim.runtime_minutes }} min</li>
+          <li>Released: {{ sim.release_date }}</li>
+        </ul>
+      </div>
+      <div class="side-card">
+        {% if current_user.is_authenticated %}
+          <form class="save-form" data-sim-id="{{ sim.id }}">
+            <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
+            {% if is_saved %}
+              <button type="button" class="btn btn-ghost" data-action="unsave">Remove from saved</button>
+            {% else %}
+              <button type="button" class="btn btn-primary" data-action="save">Save to my account</button>
+            {% endif %}
+            <p class="save-status" aria-live="polite"></p>
+          </form>
+        {% else %}
+          <a href="{{ url_for('login', next=url_for('simulation_detail', slug=sim.slug)) }}"
+             class="btn btn-primary btn-block">Sign in to save</a>
+        {% endif %}
+      </div>
+    </aside>
+  </div>
+</article>
+{% endblock %}
diff --git a/sites/phet_simulations/templates/simulations.html b/sites/phet_simulations/templates/simulations.html
new file mode 100644
index 0000000..42f2f2a
--- /dev/null
+++ b/sites/phet_simulations/templates/simulations.html
@@ -0,0 +1,68 @@
+{% extends "base.html" %}
+{% block title %}All Simulations &middot; {{ site_title }}{% endblock %}
+{% block content %}
+<h1 class="page-title">All Simulations</h1>
+<p class="page-subtitle">{{ total }} simulation{{ '' if total == 1 else 's' }} matching your filters.</p>
+
+<form class="filter-bar" method="get" action="{{ url_for('simulations') }}">
+  <label>
+    Subject
+    <select name="subject">
+      <option value="">All subjects</option>
+      {% for s in primary_subjects %}
+        <option value="{{ s.slug }}" {% if s.slug == subject %}selected{% endif %}>{{ s.name }}</option>
+      {% endfor %}
+    </select>
+  </label>
+  <label>
+    Grade level
+    <select name="grade">
+      <option value="">All grade levels</option>
+      {% for g in grade_levels %}
+        <option value="{{ g.slug }}" {% if g.slug == grade %}selected{% endif %}>{{ g.name }}</option>
+      {% endfor %}
+    </select>
+  </label>
+  <label>
+    Language
+    <select name="language">
+      <option value="">Any language</option>
+      {% for l in languages %}
+        <option value="{{ l.code }}" {% if l.code == language %}selected{% endif %}>{{ l.name }}</option>
+      {% endfor %}
+    </select>
+  </label>
+  <label>
+    Sort by
+    <select name="sort">
+      <option value="title" {% if sort == 'title' %}selected{% endif %}>Title (A-Z)</option>
+      <option value="newest" {% if sort == 'newest' %}selected{% endif %}>Newest</option>
+      <option value="popular" {% if sort == 'popular' %}selected{% endif %}>Most played</option>
+    </select>
+  </label>
+  <button type="submit" class="btn btn-primary">Apply filters</button>
+  <a href="{{ url_for('simulations') }}" class="btn btn-ghost">Reset</a>
+</form>
+
+{% if sims %}
+  <div class="sim-grid">
+    {% for sim in sims %}
+      {% include "_sim_card.html" %}
+    {% endfor %}
+  </div>
+
+  {% if total_pages > 1 %}
+    <nav class="pager" aria-label="Pagination">
+      {% if page > 1 %}
+        <a href="{{ url_for('simulations', subject=subject, grade=grade, language=language, sort=sort, page=page-1) }}">&laquo; Previous</a>
+      {% endif %}
+      <span class="pager-status">Page {{ page }} of {{ total_pages }}</span>
+      {% if page < total_pages %}
+        <a href="{{ url_for('simulations', subject=subject, grade=grade, language=language, sort=sort, page=page+1) }}">Next &raquo;</a>
+      {% endif %}
+    </nav>
+  {% endif %}
+{% else %}
+  <p class="empty-state">No simulations match the selected filters. Try clearing one of the filters above.</p>
+{% endif %}
+{% endblock %}
